  <origin rpy="1.57079632675 0 0" xyz="0 0 0.0"/>
  <parent link="erb145_link1_A"/>
  <child link="link2_A"/>
  <axis xyz="0 0 1"/>
  <limit effort="370" lower="-2.9671" upper="2.9671" velocity="1.2566"/>
</joint>

